# Build frontend, then run a lightweight Node API Gateway with Prometheus metrics.
# Build from project root: docker build -f Dockerfile.gateway .
FROM node:20-alpine AS frontend
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV PORT=8080
COPY --chown=node:node api-gateway/server.js ./server.js
COPY --from=frontend /app/dist /usr/share/api-gateway/html
USER node
EXPOSE 8080
CMD ["node", "server.js"]
